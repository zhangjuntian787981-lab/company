{
  "schema_version": 2,
  "ratings": ["PASS", "CONDITIONAL", "FAIL", "UNVERIFIED"],
  "dimensions": [
    "Security",
    "Protocol",
    "Tools",
    "Resilience",
    "Model/Context",
    "Operability"
  ],
  "hard_failures": [
    "secret or raw body persisted in report artifacts",
    "parallel tool arguments cross call IDs",
    "disconnect or incomplete classified as successful completion",
    "unbounded retry or duplicate tool side effect",
    "production port, process, launchd label, or baseline file changed",
    "unexpected main or subagent model",
    "unapproved real network request"
  ],
  "overall": {
    "FAIL": "any hard failure or failed dimension",
    "CONDITIONAL": "no failure, but one or more required checks are not PASS",
    "PASS": "all six dimensions and every required case, stage, contract, identity, and artifact check pass"
  },
  "final_report": {
    "max_evidence_age_seconds": 604800,
    "future_clock_skew_seconds": 300,
    "manifest_path": "patches/v7.2.80/manifest.json",
