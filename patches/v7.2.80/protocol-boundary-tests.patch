+package claude
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestCompatInterleavedToolArgumentDeltasAreIsolatedByCallID(t *testing.T) {
+	ctx := context.Background()
+	originalRequest := []byte(`{"tools":[{"name":"lookup","description":"lookup","input_schema":{"type":"object","properties":{}}}]}`)
+	var param any
+
+	chunks := [][]byte{
+		[]byte(`data: {"type":"response.output_item.added","item":{"type":"function_call","call_id":"call_a"}}`),
+		[]byte(`data: {"type":"response.output_item.added","item":{"type":"function_call","call_id":"call_b"}}`),
+		[]byte(`data: {"type":"response.function_call_arguments.delta","call_id":"call_a","delta":"{\"a\":"}`),
+		[]byte(`data: {"type":"response.function_call_arguments.delta","call_id":"call_b","delta":"{\"b\":"}`),
+		[]byte(`data: {"type":"response.function_call_arguments.delta","call_id":"call_a","delta":"1}"}`),
+		[]byte(`data: {"type":"response.function_call_arguments.delta","call_id":"call_b","delta":"2}"}`),
+		[]byte(`data: {"type":"response.function_call_arguments.done","call_id":"call_a","arguments":"{\"a\":1}"}`),
+		[]byte(`data: {"type":"response.function_call_arguments.done","call_id":"call_b","arguments":"{\"b\":2}"}`),
+		[]byte(`data: {"type":"response.output_item.done","item":{"type":"function_call","call_id":"call_a","name":"lookup","arguments":"{\"a\":1}"}}`),
+		[]byte(`data: {"type":"response.output_item.done","item":{"type":"function_call","call_id":"call_b","name":"lookup","arguments":"{\"b\":2}"}}`),
+	}
+
+	var outputs [][]byte
+	for _, chunk := range chunks {
+		outputs = append(outputs, ConvertCodexResponseToClaude(ctx, "", originalRequest, nil, chunk, &param)...)
+	}
+
+	callByIndex := map[int64]string{}
+	argsByIndex := map[int64]string{}
+	for _, out := range outputs {
+		for _, line := range strings.Split(string(out), "\n") {
+			if !strings.HasPrefix(line, "data: ") {
+				continue
+			}
+			data := gjson.Parse(strings.TrimPrefix(line, "data: "))
+			switch data.Get("type").String() {
+			case "content_block_start":
+				if data.Get("content_block.type").String() == "tool_use" {
+					callByIndex[data.Get("index").Int()] = data.Get("content_block.id").String()
+				}
+			case "content_block_delta":
+				if data.Get("delta.type").String() == "input_json_delta" {
+					idx := data.Get("index").Int()
+					argsByIndex[idx] += data.Get("delta.partial_json").String()
+				}
+			}
+		}
+	}
+
+	argsByCall := map[string]string{}
+	for idx, callID := range callByIndex {
+		argsByCall[callID] = argsByIndex[idx]
+	}
+	if got := argsByCall["call_a"]; got != `{"a":1}` {
+		t.Fatalf("call_a arguments = %q, want %q; outputs=%q", got, `{"a":1}`, outputs)
+	}
+	if got := argsByCall["call_b"]; got != `{"b":2}` {
+		t.Fatalf("call_b arguments = %q, want %q; interleaved deltas crossed call IDs; outputs=%q", got, `{"b":2}`, outputs)
+	}
+}
+
+func TestCompatClaudeRequestProtocolMapping(t *testing.T) {
+	input := []byte(`{
+		"model":"claude-opus-4-8",
+		"max_tokens":321,
+		"stop_sequences":["END"],
+		"context_management":{"edits":[{"type":"clear_tool_uses_20250919"}]},
+		"tools":[{
+			"name":"lookup",
+			"description":"lookup",
+			"strict":true,
+			"defer_loading":true,
+			"input_schema":{"type":"object","properties":{"id":{"type":"integer"}},"required":["id"],"additionalProperties":false}
+		}],
+		"messages":[{"role":"user","content":[
+			{"type":"document","source":{"type":"base64","media_type":"application/pdf","data":"JVBERi0xLjQ="}},
+			{"type":"text","text":"summarize"}
+		]}]
+	}`)
+
+	out := ConvertClaudeRequestToCodex("gpt-5.6-sol", input, false)
+	parsed := gjson.ParseBytes(out)
+
+	for _, path := range []string{"max_tokens", "stop", "stop_sequences", "context_management", "tools.0.defer_loading"} {
+		if parsed.Get(path).Exists() {
+			t.Errorf("%s unexpectedly survived translation: %s", path, out)
+		}
+	}
+	if got := parsed.Get("max_output_tokens").Int(); got != 321 {
+		t.Errorf("max_output_tokens = %d, want 321: %s", got, out)
+	}
+	if got := parsed.Get("tools.0.strict").Bool(); !got {
+		t.Errorf("tools.0.strict = false, want true: %s", out)
+	}
+	if file := parsed.Get("input.0.content.0"); file.Get("type").String() != "input_file" || file.Get("file_data").String() != "JVBERi0xLjQ=" || file.Get("filename").String() != "document.pdf" || parsed.Get("input.0.content.1.text").String() != "summarize" {
+		t.Errorf("document mapping was not preserved: %s", out)
+	}
+}
+
+func TestCompatClaudeAdaptiveEffortTranslation(t *testing.T) {
+	tests := []struct {
+		name       string
+		thinking   string
+		wantEffort string
+	}{
+		{name: "No thinking defaults medium", wantEffort: "medium"},
+		{name: "Adaptive omitted effort defaults xhigh", thinking: `,"thinking":{"type":"adaptive"}`, wantEffort: "xhigh"},
+		{name: "Adaptive low", thinking: `,"thinking":{"type":"adaptive"},"output_config":{"effort":"low"}`, wantEffort: "low"},
+		{name: "Adaptive medium", thinking: `,"thinking":{"type":"adaptive"},"output_config":{"effort":"medium"}`, wantEffort: "medium"},
+		{name: "Adaptive high", thinking: `,"thinking":{"type":"adaptive"},"output_config":{"effort":"high"}`, wantEffort: "high"},
+		{name: "Adaptive xhigh", thinking: `,"thinking":{"type":"adaptive"},"output_config":{"effort":"xhigh"}`, wantEffort: "xhigh"},
+		{name: "Adaptive max", thinking: `,"thinking":{"type":"adaptive"},"output_config":{"effort":"max"}`, wantEffort: "max"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			input := []byte(`{"messages":[{"role":"user","content":"hello"}]` + tc.thinking + `}`)
+			out := ConvertClaudeRequestToCodex("gpt-5.6-sol", input, false)
+			if got := gjson.GetBytes(out, "reasoning.effort").String(); got != tc.wantEffort {
+				t.Fatalf("reasoning.effort = %q, want %q; output=%s", got, tc.wantEffort, out)
+			}
+		})
+	}
+}
+
+func TestCompatStopReasonTranslation(t *testing.T) {
+	tests := []struct {
+		upstream string
+		want     string
+	}{
+		{upstream: "stop", want: "end_turn"},
+		{upstream: "max_tokens", want: "max_tokens"},
+		{upstream: "max_output_tokens", want: "max_tokens"},
+		{upstream: "stop_sequence", want: "stop_sequence"},
+		{upstream: "pause_turn", want: "pause_turn"},
+		{upstream: "refusal", want: "refusal"},
+		{upstream: "content_filter", want: "refusal"},
+		{upstream: "model_context_window_exceeded", want: "model_context_window_exceeded"},
+		{upstream: "unknown_future_reason", want: "end_turn"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.upstream, func(t *testing.T) {
+			if got := mapCodexStopReasonToClaude(tc.upstream, false); got != tc.want {
+				t.Fatalf("stop reason %q maps to %q, want %q", tc.upstream, got, tc.want)
+			}
+		})
+	}
+}
