+func TestClaudeContextManagementAcceptsClaudeCodeClearThinking(t *testing.T) {
+	policy, err := preflightClaudeRequest([]byte(`{
+		"model":"test",
+		"max_tokens":64,
+		"context_management":{"edits":[{"type":"clear_thinking_20251015","keep":"all"}]},
+		"messages":[{"role":"user","content":"current"}]
+	}`))
+	if err != nil {
+		t.Fatalf("preflight: %v", err)
+	}
+	if gjson.GetBytes(policy.rawJSON, "context_management").Exists() {
+		t.Fatalf("context_management reached upstream: %s", policy.rawJSON)
+	}
+	if got := gjson.GetBytes(policy.rawJSON, "messages.0.content").String(); got != "current" {
+		t.Fatalf("message content = %q, want current", got)
+	}
+}
