+func TestConvertClaudeRequestToCodex_ToolStrictMapping(t *testing.T) {
+	tests := []struct {
+		name       string
+		strictJSON string
+		want       bool
+	}{
+		{name: "Preserve strict true", strictJSON: `,"strict":true`, want: true},
+		{name: "Default strict false", want: false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			inputJSON := `{
+				"model":"claude-opus-4-8",
+				"tools":[{
+					"name":"lookup",
+					"description":"Lookup",
+					"input_schema":{"type":"object","properties":{},"additionalProperties":false}
+					` + tt.strictJSON + `
+				}],
+				"messages":[{"role":"user","content":"hello"}]
+			}`
+
+			result := ConvertClaudeRequestToCodex("gpt-5.6-sol", []byte(inputJSON), false)
+			strict := gjson.GetBytes(result, "tools.0.strict")
+			if !strict.Exists() {
+				t.Fatalf("tools.0.strict is missing. Output: %s", result)
+			}
+			if got := strict.Bool(); got != tt.want {
+				t.Fatalf("tools.0.strict = %v, want %v. Output: %s", got, tt.want, result)
+			}
+		})
+	}
+}
