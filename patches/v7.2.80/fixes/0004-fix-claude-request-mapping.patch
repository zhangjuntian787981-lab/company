+func TestConvertClaudeRequestToCodex_DocumentContentMapping(t *testing.T) {
+	tests := []struct {
+		name          string
+		document      string
+		wantField     string
+		wantValue     string
+		wantFilename  string
+		unwantedField string
+	}{
+		{
+			name:          "Base64 PDF",
+			document:      `{"type":"document","title":"../report.pdf","source":{"type":"base64","media_type":"application/pdf","data":"JVBERi0xLjQ="}}`,
+			wantField:     "file_data",
+			wantValue:     "JVBERi0xLjQ=",
+			wantFilename:  "report.pdf",
+			unwantedField: "file_url",
+		},
+		{
+			name:          "URL PDF with generated filename",
+			document:      `{"type":"document","source":{"type":"url","media_type":"application/pdf","url":"https://example.com/report.pdf"}}`,
+			wantField:     "file_url",
+			wantValue:     "https://example.com/report.pdf",
+			wantFilename:  "document.pdf",
+			unwantedField: "file_data",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			inputJSON := `{
+				"model":"claude-opus-4-8",
+				"messages":[{"role":"user","content":[
+					` + tt.document + `,
+					{"type":"text","text":"summarize"}
+				]}]
+			}`
+
+			result := ConvertClaudeRequestToCodex("gpt-5.6-sol", []byte(inputJSON), false)
+			file := gjson.GetBytes(result, "input.0.content.0")
+			if got := file.Get("type").String(); got != "input_file" {
+				t.Fatalf("document type = %q, want input_file. Output: %s", got, result)
+			}
+			if got := file.Get(tt.wantField).String(); got != tt.wantValue {
+				t.Fatalf("document %s = %q, want %q. Output: %s", tt.wantField, got, tt.wantValue, result)
+			}
+			if got := file.Get("filename").String(); got != tt.wantFilename {
+				t.Fatalf("document filename = %q, want %q. Output: %s", got, tt.wantFilename, result)
+			}
+			if file.Get(tt.unwantedField).Exists() {
+				t.Fatalf("document unexpectedly contains %s. Output: %s", tt.unwantedField, result)
+			}
+			if got := gjson.GetBytes(result, "input.0.content.1.text").String(); got != "summarize" {
+				t.Fatalf("neighboring text = %q, want summarize. Output: %s", got, result)
+			}
+		})
+	}
+}
