+func TestConvertClaudeRequestToCodex_MaxTokensMapping(t *testing.T) {
+	inputJSON := `{
+		"model":"claude-opus-4-8",
+		"max_tokens":321,
+		"messages":[{"role":"user","content":"hello"}]
+	}`
+
+	result := ConvertClaudeRequestToCodex("gpt-5.6-sol", []byte(inputJSON), false)
+	if got := gjson.GetBytes(result, "max_output_tokens").Int(); got != 321 {
+		t.Fatalf("max_output_tokens = %d, want 321. Output: %s", got, result)
+	}
+	if gjson.GetBytes(result, "max_tokens").Exists() {
+		t.Fatalf("Claude max_tokens should not survive under its original name. Output: %s", result)
+	}
+}
