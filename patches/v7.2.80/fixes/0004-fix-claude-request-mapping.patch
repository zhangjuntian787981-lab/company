+func TestConvertClaudeRequestToCodex_StopSequencesAreNotForwarded(t *testing.T) {
+	inputJSON := `{
+		"model":"claude-opus-4-8",
+		"stop_sequences":["END","DONE"],
+		"messages":[{"role":"user","content":"hello"}]
+	}`
+
+	result := ConvertClaudeRequestToCodex("gpt-5.6-sol", []byte(inputJSON), false)
+	for _, path := range []string{"stop", "stop_sequences"} {
+		if gjson.GetBytes(result, path).Exists() {
+			t.Fatalf("unsupported Codex Responses field %s was forwarded. Output: %s", path, result)
+		}
+	}
+}
