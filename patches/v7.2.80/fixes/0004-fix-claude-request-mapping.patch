+func claudeDocumentFilename(title, mediaType string) string {
+	candidate := strings.TrimSpace(strings.ReplaceAll(title, "\\", "/"))
+	if candidate != "" {
+		candidate = path.Base(candidate)
+		if candidate != "." && candidate != "/" && candidate != ".." {
+			return candidate
+		}
+	}
+
+	extension := ".bin"
+	switch strings.ToLower(strings.TrimSpace(mediaType)) {
+	case "application/pdf":
+		extension = ".pdf"
+	case "application/json":
+		extension = ".json"
+	case "text/html":
+		extension = ".html"
+	case "text/markdown":
+		extension = ".md"
+	case "text/plain":
+		extension = ".txt"
+	}
+	return "document" + extension
+}
