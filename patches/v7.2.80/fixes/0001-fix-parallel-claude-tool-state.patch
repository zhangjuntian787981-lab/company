+func TestConvertCodexResponseToClaude_StreamInterleavedNamedFunctionCallsStayIsolated(t *testing.T) {
+	ctx := context.Background()
+	originalRequest := []byte(`{"tools":[{"name":"alpha_tool"},{"name":"beta_tool"}]}`)
+	var param any
+
+	chunks := [][]byte{
+		[]byte(`data: {"type":"response.created","response":{"id":"resp_1","model":"gpt-5"}}`),
+		[]byte(`data: {"type":"response.output_item.added","output_index":0,"item":{"type":"function_call","call_id":"call_a","name":"alpha_tool"}}`),
+		[]byte(`data: {"type":"response.output_item.added","output_index":1,"item":{"type":"function_call","call_id":"call_b","name":"beta_tool"}}`),
+		[]byte(`data: {"type":"response.function_call_arguments.delta","output_index":0,"delta":"{\"value\":\"al"}`),
+		[]byte(`data: {"type":"response.function_call_arguments.delta","output_index":1,"delta":"{\"value\":\"be"}`),
+		[]byte(`data: {"type":"response.function_call_arguments.delta","output_index":0,"delta":"pha\",\"n\":1}"}`),
+		[]byte(`data: {"type":"response.function_call_arguments.delta","output_index":1,"delta":"ta\",\"n\":2}"}`),
+		[]byte(`data: {"type":"response.output_item.done","output_index":0,"item":{"type":"function_call","call_id":"call_a","name":"alpha_tool","arguments":"{\"value\":\"alpha\",\"n\":1}"}}`),
+		[]byte(`data: {"type":"response.output_item.done","output_index":1,"item":{"type":"function_call","call_id":"call_b","name":"beta_tool","arguments":"{\"value\":\"beta\",\"n\":2}"}}`),
+		[]byte(`data: {"type":"response.completed","response":{"usage":{"input_tokens":1,"output_tokens":1}}}`),
+	}
+
+	toolIDs := map[int64]string{}
+	arguments := map[int64]string{}
+	stops := map[int64]int{}
+	for _, chunk := range chunks {
+		for _, out := range ConvertCodexResponseToClaude(ctx, "", originalRequest, nil, chunk, &param) {
+			for _, line := range strings.Split(string(out), "\n") {
+				if !strings.HasPrefix(line, "data: ") {
+					continue
+				}
+				data := gjson.Parse(strings.TrimPrefix(line, "data: "))
+				index := data.Get("index").Int()
+				switch data.Get("type").String() {
+				case "content_block_start":
+					if data.Get("content_block.type").String() == "tool_use" {
+						toolIDs[index] = data.Get("content_block.id").String()
+					}
+				case "content_block_delta":
+					if data.Get("delta.type").String() == "input_json_delta" {
+						arguments[index] += data.Get("delta.partial_json").String()
+					}
+				case "content_block_stop":
+					stops[index]++
+				}
+			}
+		}
+	}
+
+	if toolIDs[0] != "call_a" || arguments[0] != `{"value":"alpha","n":1}` || stops[0] != 1 {
+		t.Fatalf("call_a state crossed calls: ids=%v arguments=%v stops=%v", toolIDs, arguments, stops)
+	}
+	if toolIDs[1] != "call_b" || arguments[1] != `{"value":"beta","n":2}` || stops[1] != 1 {
+		t.Fatalf("call_b state crossed calls: ids=%v arguments=%v stops=%v", toolIDs, arguments, stops)
+	}
+}
