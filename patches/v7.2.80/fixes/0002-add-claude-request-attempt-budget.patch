new file mode 100644
index 0000000..00a2f1d
--- /dev/null
+++ b/sdk/cliproxy/auth/request_budget_test.go
@@ -0,0 +1,197 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+func TestRequestBudgetAllowsOnlyRefreshAuthorizedGenerationReplay(t *testing.T) {
+	ctx := WithRequestBudget(context.Background(), RequestBudgetLimits{
+		GenerationAttempts: 2,
+		RefreshAttempts:    1,
+	})
+
+	if err := consumeGenerationAttempt(ctx); err != nil {
+		t.Fatalf("initial generation attempt failed: %v", err)
+	}
+	if err := consumeGenerationAttempt(ctx); err == nil {
+		t.Fatal("generation replay succeeded without an authorized refresh")
+	}
+	if err := consumeRefreshAttempt(ctx); err != nil {
+		t.Fatalf("refresh attempt failed: %v", err)
+	}
+	allowPostRefreshGeneration(ctx)
+	if err := consumeGenerationAttempt(ctx); err != nil {
+		t.Fatalf("post-refresh generation attempt failed: %v", err)
+	}
+	if err := consumeGenerationAttempt(ctx); err == nil {
+		t.Fatal("third generation attempt exceeded the budget but succeeded")
+	}
+
+	snapshot, ok := RequestBudgetSnapshotFromContext(ctx)
+	if !ok {
+		t.Fatal("request budget snapshot was unavailable")
+	}
+	if snapshot.GenerationAttempts != 2 || snapshot.RefreshAttempts != 1 {
+		t.Fatalf("unexpected request budget snapshot: %#v", snapshot)
+	}
+}
+
+func TestRequestBudgetCommitPreventsPostRefreshReplay(t *testing.T) {
+	ctx := WithRequestBudget(context.Background(), RequestBudgetLimits{
+		GenerationAttempts: 2,
+		RefreshAttempts:    1,
+	})
+	if err := consumeGenerationAttempt(ctx); err != nil {
+		t.Fatalf("initial generation attempt failed: %v", err)
+	}
+	if err := consumeRefreshAttempt(ctx); err != nil {
+		t.Fatalf("refresh attempt failed: %v", err)
+	}
+	allowPostRefreshGeneration(ctx)
+	MarkRequestBudgetCommitted(ctx)
+	if err := consumeGenerationAttempt(ctx); err == nil {
+		t.Fatal("generation replay succeeded after output was committed")
+	}
+
+	snapshot, ok := RequestBudgetSnapshotFromContext(ctx)
+	if !ok || !snapshot.Committed {
+		t.Fatalf("request budget did not record response commit: %#v", snapshot)
+	}
+}
+
+func TestRequestBudgetSeparatesCountAttempts(t *testing.T) {
+	ctx := WithRequestBudget(context.Background(), RequestBudgetLimits{
+		CountAttempts:   2,
+		RefreshAttempts: 1,
+	})
+	if err := consumeCountAttempt(ctx); err != nil {
+		t.Fatalf("initial count attempt failed: %v", err)
+	}
+	if err := consumeCountAttempt(ctx); err == nil {
+		t.Fatal("count replay succeeded without a refresh")
+	}
+	if err := consumeRefreshAttempt(ctx); err != nil {
+		t.Fatalf("refresh attempt failed: %v", err)
+	}
+	allowPostRefreshCount(ctx)
+	if err := consumeCountAttempt(ctx); err != nil {
+		t.Fatalf("post-refresh count attempt failed: %v", err)
+	}
+}
+
+func TestManagerRequestBudgetStopsCrossCredentialAttempts(t *testing.T) {
+	request := cliproxyexecutor.Request{Model: "test-model"}
+	testCases := []struct {
+		name   string
+		limits RequestBudgetLimits
+		invoke func(context.Context, *Manager) error
+	}{
+		{
+			name:   "execute",
+			limits: RequestBudgetLimits{GenerationAttempts: 2, RefreshAttempts: 1},
+			invoke: func(ctx context.Context, manager *Manager) error {
+				_, err := manager.Execute(ctx, []string{"claude"}, request, cliproxyexecutor.Options{})
+				return err
+			},
+		},
+		{
+			name:   "execute_stream",
+			limits: RequestBudgetLimits{GenerationAttempts: 2, RefreshAttempts: 1},
+			invoke: func(ctx context.Context, manager *Manager) error {
+				_, err := manager.ExecuteStream(ctx, []string{"claude"}, request, cliproxyexecutor.Options{})
+				return err
+			},
+		},
+		{
+			name:   "count_tokens",
+			limits: RequestBudgetLimits{CountAttempts: 2, RefreshAttempts: 1},
+			invoke: func(ctx context.Context, manager *Manager) error {
+				_, err := manager.ExecuteCount(ctx, []string{"claude"}, request, cliproxyexecutor.Options{})
+				return err
+			},
+		},
+	}
+
+	for _, testCase := range testCases {
+		t.Run(testCase.name, func(t *testing.T) {
+			manager, executor := newCredentialRetryLimitTestManager(t, 0)
+			ctx := WithRequestBudget(context.Background(), testCase.limits)
+			if err := testCase.invoke(ctx, manager); err == nil {
+				t.Fatal("expected provider error")
+			} else if statusCodeFromError(err) != http.StatusInternalServerError {
+				t.Fatalf("provider status = %d, want 500: %v", statusCodeFromError(err), err)
+			}
+			if calls := executor.Calls(); calls != 1 {
+				t.Fatalf("provider calls = %d, want 1", calls)
+			}
+		})
+	}
+}
