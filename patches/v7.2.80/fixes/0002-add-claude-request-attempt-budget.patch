+func TestManagerRequestBudgetBlocksFallbackAfterRefreshFailure(t *testing.T) {
+	manager, executor, primary, backup, model := newUnauthorizedRefreshFixture(t, true)
+	ctx := WithRequestBudget(context.Background(), RequestBudgetLimits{
+		GenerationAttempts: 2,
+		RefreshAttempts:    1,
+	})
+
+	_, err := manager.Execute(ctx, []string{"codex"}, cliproxyexecutor.Request{Model: model}, cliproxyexecutor.Options{})
+	if err == nil || statusCodeFromError(err) != http.StatusUnauthorized {
+		t.Fatalf("Execute error = %v, want original 401 after failed refresh", err)
+	}
+	if calls := executor.ExecuteCalls(); len(calls) != 1 || calls[0] != primary.ID {
+		t.Fatalf("Execute calls = %v, want only primary", calls)
+	}
+	if executor.RefreshCalls() != 1 {
+		t.Fatalf("Refresh calls = %d, want 1", executor.RefreshCalls())
+	}
+	for _, id := range executor.ExecuteCalls() {
+		if id == backup.ID {
+			t.Fatal("backup credential bypassed the request budget")
+		}
+	}
+}
