+func TestManagerRequestBudgetAllowsOneSuccessfulUnauthorizedRefreshReplay(t *testing.T) {
+	manager, executor, primary, backup, model := newUnauthorizedRefreshFixture(t, false)
+	ctx := WithRequestBudget(context.Background(), RequestBudgetLimits{
+		GenerationAttempts: 2,
+		RefreshAttempts:    1,
+	})
+
+	response, err := manager.Execute(ctx, []string{"codex"}, cliproxyexecutor.Request{Model: model}, cliproxyexecutor.Options{})
+	if err != nil {
+		t.Fatalf("Execute error = %v, want successful refresh replay", err)
+	}
+	if got := string(response.Payload); got != primary.ID+":fresh-access-token" {
+		t.Fatalf("payload = %q, want refreshed primary response", got)
+	}
+	if calls := executor.ExecuteCalls(); len(calls) != 2 || calls[0] != primary.ID || calls[1] != primary.ID {
+		t.Fatalf("Execute calls = %v, want [primary, primary]", calls)
+	}
+	if executor.RefreshCalls() != 1 {
+		t.Fatalf("Refresh calls = %d, want 1", executor.RefreshCalls())
+	}
+	for _, id := range executor.ExecuteCalls() {
+		if id == backup.ID {
+			t.Fatal("backup credential bypassed the request budget")
+		}
+	}
+}
