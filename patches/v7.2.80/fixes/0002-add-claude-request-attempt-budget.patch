+func TestRequestBudgetAbsentPreservesExistingExecution(t *testing.T) {
+	ctx := context.Background()
+	if err := consumeGenerationAttempt(ctx); err != nil {
+		t.Fatalf("generation attempt without a budget failed: %v", err)
+	}
+	if err := consumeCountAttempt(ctx); err != nil {
+		t.Fatalf("count attempt without a budget failed: %v", err)
+	}
+	if err := consumeRefreshAttempt(ctx); err != nil {
+		t.Fatalf("refresh attempt without a budget failed: %v", err)
+	}
+}
