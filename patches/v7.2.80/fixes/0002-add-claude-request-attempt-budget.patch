diff --git a/sdk/cliproxy/auth/request_budget.go b/sdk/cliproxy/auth/request_budget.go
new file mode 100644
index 0000000..4507b7e
--- /dev/null
+++ b/sdk/cliproxy/auth/request_budget.go
@@ -0,0 +1,187 @@
+package auth
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"sync"
+)
+
+// RequestBudgetLimits bounds real provider actions for one inbound request.
+type RequestBudgetLimits struct {
+	GenerationAttempts int
+	CountAttempts      int
+	RefreshAttempts    int
+}
+
+// RequestBudgetSnapshot exposes counters without the request payload or credentials.
+type RequestBudgetSnapshot struct {
+	GenerationAttempts int
+	CountAttempts      int
+	RefreshAttempts    int
+	Committed          bool
+}
+
+type requestBudgetContextKey struct{}
+
+type requestAttemptBudget struct {
+	mu sync.Mutex
+
+	limits RequestBudgetLimits
+
+	generationAttempts int
+	countAttempts      int
+	refreshAttempts    int
+
+	postRefreshGeneration bool
+	postRefreshCount      bool
+	committed             bool
+}
+
+// WithRequestBudget attaches a request-scoped attempt budget to ctx.
+func WithRequestBudget(ctx context.Context, limits RequestBudgetLimits) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if limits.GenerationAttempts < 0 {
+		limits.GenerationAttempts = 0
+	}
+	if limits.CountAttempts < 0 {
+		limits.CountAttempts = 0
+	}
+	if limits.RefreshAttempts < 0 {
+		limits.RefreshAttempts = 0
+	}
+	return context.WithValue(ctx, requestBudgetContextKey{}, &requestAttemptBudget{limits: limits})
+}
+
+// RequestBudgetSnapshotFromContext returns sanitized request-attempt counters.
+func RequestBudgetSnapshotFromContext(ctx context.Context) (RequestBudgetSnapshot, bool) {
+	budget := requestBudgetFromContext(ctx)
+	if budget == nil {
+		return RequestBudgetSnapshot{}, false
+	}
+	budget.mu.Lock()
+	defer budget.mu.Unlock()
+	return RequestBudgetSnapshot{
+		GenerationAttempts: budget.generationAttempts,
+		CountAttempts:      budget.countAttempts,
+		RefreshAttempts:    budget.refreshAttempts,
+		Committed:          budget.committed,
+	}, true
+}
+
+// MarkRequestBudgetCommitted prevents any later generation replay after output is visible.
+func MarkRequestBudgetCommitted(ctx context.Context) {
+	budget := requestBudgetFromContext(ctx)
+	if budget == nil {
+		return
+	}
+	budget.mu.Lock()
+	budget.committed = true
+	budget.postRefreshGeneration = false
+	budget.postRefreshCount = false
+	budget.mu.Unlock()
+}
+
+func requestBudgetFromContext(ctx context.Context) *requestAttemptBudget {
+	if ctx == nil {
+		return nil
+	}
+	budget, _ := ctx.Value(requestBudgetContextKey{}).(*requestAttemptBudget)
+	return budget
+}
+
+func requestBudgetEnabled(ctx context.Context) bool {
+	return requestBudgetFromContext(ctx) != nil
+}
+
+func consumeGenerationAttempt(ctx context.Context) error {
+	budget := requestBudgetFromContext(ctx)
+	if budget == nil {
+		return nil
+	}
+	budget.mu.Lock()
+	defer budget.mu.Unlock()
+	if budget.committed {
+		return requestBudgetExceeded("generation after response commit")
+	}
+	if budget.generationAttempts == 0 && budget.limits.GenerationAttempts > 0 {
+		budget.generationAttempts++
+		return nil
+	}
+	if budget.postRefreshGeneration && budget.generationAttempts < budget.limits.GenerationAttempts {
+		budget.postRefreshGeneration = false
+		budget.generationAttempts++
+		return nil
+	}
+	return requestBudgetExceeded("generation")
+}
+
+func consumeCountAttempt(ctx context.Context) error {
+	budget := requestBudgetFromContext(ctx)
+	if budget == nil {
+		return nil
+	}
+	budget.mu.Lock()
+	defer budget.mu.Unlock()
+	if budget.committed {
+		return requestBudgetExceeded("token count after response commit")
+	}
+	if budget.countAttempts == 0 && budget.limits.CountAttempts > 0 {
+		budget.countAttempts++
+		return nil
+	}
+	if budget.postRefreshCount && budget.countAttempts < budget.limits.CountAttempts {
+		budget.postRefreshCount = false
+		budget.countAttempts++
+		return nil
+	}
+	return requestBudgetExceeded("token count")
+}
+
+func consumeRefreshAttempt(ctx context.Context) error {
+	budget := requestBudgetFromContext(ctx)
+	if budget == nil {
+		return nil
+	}
+	budget.mu.Lock()
+	defer budget.mu.Unlock()
+	if budget.committed || budget.refreshAttempts >= budget.limits.RefreshAttempts {
+		return requestBudgetExceeded("credential refresh")
+	}
+	budget.refreshAttempts++
+	return nil
+}
+
+func allowPostRefreshGeneration(ctx context.Context) {
+	budget := requestBudgetFromContext(ctx)
+	if budget == nil {
+		return
+	}
+	budget.mu.Lock()
+	if !budget.committed {
+		budget.postRefreshGeneration = true
+	}
+	budget.mu.Unlock()
+}
+
+func allowPostRefreshCount(ctx context.Context) {
+	budget := requestBudgetFromContext(ctx)
+	if budget == nil {
+		return
+	}
+	budget.mu.Lock()
+	if !budget.committed {
+		budget.postRefreshCount = true
+	}
+	budget.mu.Unlock()
+}
+
+func requestBudgetExceeded(action string) error {
+	return &Error{
+		Code:       requestScopedErrorCode,
+		Message:    fmt.Sprintf("request attempt budget exhausted for %s", action),
+		HTTPStatus: http.StatusFailedDependency,
+	}
+}
