+func TestGatewayRejectsRepeatedToolIDAcrossDistinctRequests(t *testing.T) {
+	var calls atomic.Int64
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		calls.Add(1)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"type":"message","content":[{"type":"tool_use","id":"tool_1","name":"mutate","input":{"value":1}}]}`)
+	}))
+	defer target.Close()
+
+	gateway := newTestGateway(t, target.URL)
+	server := httptest.NewServer(gateway)
+	defer server.Close()
+
+	status, _ := postTestRequest(t, server.URL, []byte(`{"model":"test","messages":[{"role":"user","content":"first"}]}`))
+	if status != http.StatusOK {
+		t.Fatalf("first tool response status = %d, want 200", status)
+	}
+	status, body := postTestRequest(t, server.URL, []byte(`{"model":"test","messages":[{"role":"user","content":"second"}]}`))
+	if status != http.StatusFailedDependency || !bytes.Contains(body, []byte("emitted more than once")) {
+		t.Fatalf("duplicate tool response = %d/%q, want 424 duplicate error", status, body)
+	}
+	if got := calls.Load(); got != 2 {
+		t.Fatalf("upstream calls = %d, want 2 distinct requests", got)
+	}
+}
