+func readSSEFrame(reader *bufio.Reader) ([]byte, error) {
+	var frame []byte
+	for {
+		line, err := reader.ReadBytes('\n')
+		frame = append(frame, line...)
+		if len(bytes.TrimSpace(line)) == 0 && len(frame) > 0 {
+			return frame, err
+		}
+		if err != nil {
+			return frame, err
+		}
+	}
+}
