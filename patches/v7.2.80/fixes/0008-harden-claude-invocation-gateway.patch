+func TestGatewayFingerprintCanonicalizesJSONBody(t *testing.T) {
+	requestA, err := http.NewRequest(http.MethodPost, "http://127.0.0.1:9000/v1/messages", bytes.NewBufferString(`{"model":"test","stream":true,"metadata":{"b":2,"a":1}}`))
+	if err != nil {
+		t.Fatalf("NewRequest A: %v", err)
+	}
+	requestB, err := http.NewRequest(http.MethodPost, "http://127.0.0.1:9000/v1/messages", bytes.NewBufferString("{\n  \"metadata\": {\"a\": 1, \"b\": 2},\n  \"stream\": true,\n  \"model\": \"test\"\n}"))
+	if err != nil {
+		t.Fatalf("NewRequest B: %v", err)
+	}
+	requestA.Header.Set("Content-Type", "application/json")
+	requestB.Header.Set("Content-Type", "application/json")
+	if got, want := requestFingerprint(requestA, []byte(`{"model":"test","stream":true,"metadata":{"b":2,"a":1}}`)), requestFingerprint(requestB, []byte("{\n  \"metadata\": {\"a\": 1, \"b\": 2},\n  \"stream\": true,\n  \"model\": \"test\"\n}")); got != want {
+		t.Fatalf("semantically identical JSON requests produced different fingerprints")
+	}
+}
