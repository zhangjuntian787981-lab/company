+func (g *Gateway) claimJSONToolUses(body []byte) error {
+	var response struct {
+		Content []struct {
+			Type  string          `json:"type"`
+			ID    string          `json:"id"`
+			Name  string          `json:"name"`
+			Input json.RawMessage `json:"input"`
+		} `json:"content"`
+	}
+	if err := json.Unmarshal(body, &response); err != nil {
+		return nil
+	}
+	for _, block := range response.Content {
+		if block.Type != "tool_use" {
+			continue
+		}
+		arguments := block.Input
+		if len(arguments) == 0 {
+			arguments = []byte(`{}`)
+		}
+		if err := g.claimToolUse(block.ID, block.Name, arguments); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (g *Gateway) claimToolUse(id, name string, arguments []byte) error {
+	id = strings.TrimSpace(id)
+	name = strings.TrimSpace(name)
+	if id == "" || name == "" {
+		return errors.New("tool response omitted its id or name")
+	}
+	if !json.Valid(arguments) {
+		return fmt.Errorf("tool %s emitted invalid JSON arguments", id)
+	}
+	canonical, _, _ := canonicalRequestBody(arguments)
+	argumentsHash := sha256.Sum256(canonical)
+
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	existing, ok := g.tools[id]
+	if !ok {
+		g.tools[id] = toolLedgerEntry{name: name, argumentsHash: argumentsHash}
+		return nil
+	}
+	if existing.name != name || existing.argumentsHash != argumentsHash {
+		return fmt.Errorf("tool id %s was reused with different arguments", id)
+	}
+	return fmt.Errorf("tool id %s was emitted more than once", id)
+}
+
+func (g *Gateway) observeToolResults(body []byte) {
+	var value any
+	if json.Unmarshal(body, &value) != nil {
+		return
+	}
+	ids := make(map[string]struct{})
+	collectToolResultIDs(value, ids)
+	if len(ids) == 0 {
+		return
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	for id := range ids {
+		entry, ok := g.tools[id]
+		if !ok {
+			continue
+		}
+		entry.resultSeen = true
+		g.tools[id] = entry
+	}
+}
+
+func collectToolResultIDs(value any, ids map[string]struct{}) {
+	switch item := value.(type) {
+	case map[string]any:
+		if item["type"] == "tool_result" {
+			if id, ok := item["tool_use_id"].(string); ok && strings.TrimSpace(id) != "" {
+				ids[strings.TrimSpace(id)] = struct{}{}
+			}
+		}
+		for _, child := range item {
+			collectToolResultIDs(child, ids)
+		}
+	case []any:
+		for _, child := range item {
+			collectToolResultIDs(child, ids)
+		}
+	}
+}
