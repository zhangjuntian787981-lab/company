+func TestRequestBudgetRefreshAttemptLimit(t *testing.T) {
+	if got := RequestBudgetRefreshAttemptLimit(context.Background(), 3); got != 3 {
+		t.Fatalf("unbudgeted refresh attempt limit = %d, want 3", got)
+	}
+	ctx := WithRequestBudget(context.Background(), RequestBudgetLimits{RefreshAttempts: 1})
+	if got := RequestBudgetRefreshAttemptLimit(ctx, 3); got != 1 {
+		t.Fatalf("budgeted refresh attempt limit = %d, want 1", got)
+	}
