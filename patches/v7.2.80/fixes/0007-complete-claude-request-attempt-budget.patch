+// RequestBudgetRefreshAttemptLimit returns one real token-endpoint attempt when a request budget is active.
+func RequestBudgetRefreshAttemptLimit(ctx context.Context, fallback int) int {
+	if fallback < 1 {
+		fallback = 1
+	}
+	if requestBudgetFromContext(ctx) != nil {
+		return 1
+	}
+	return fallback
+}
