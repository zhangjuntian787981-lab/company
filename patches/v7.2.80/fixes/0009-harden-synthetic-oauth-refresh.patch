+func TestManager_ConcurrentStaleTokenRefreshesOnce(t *testing.T) {
+	started := make(chan struct{})
+	release := make(chan struct{})
+	auth := &Auth{
+		ID:       "codex-concurrent-refresh",
+		Provider: "codex",
+		Metadata: map[string]any{
+			"access_token":  "stale-access-token",
+			"refresh_token": "synthetic-refresh-token",
+		},
+	}
+	executor := &unauthorizedRefreshExecutor{
+		id:             "codex",
+		refreshTokens:  map[string]string{auth.ID: "fresh-access-token"},
+		refreshStarted: started,
+		refreshRelease: release,
+	}
+	manager := NewManager(nil, nil, nil)
+	manager.RegisterExecutor(executor)
+	if _, errRegister := manager.Register(context.Background(), auth); errRegister != nil {
+		t.Fatalf("register auth: %v", errRegister)
+	}
+
+	results := make(chan *Auth, 2)
+	errs := make(chan error, 2)
+	runRefresh := func() {
+		refreshed, errRefresh := manager.refreshAuthForRequest(context.Background(), auth.ID, "stale-access-token")
+		results <- refreshed
+		errs <- errRefresh
+	}
+	go runRefresh()
+	<-started
+	go runRefresh()
+	time.Sleep(20 * time.Millisecond)
+	if got := executor.RefreshCalls(); got != 1 {
+		t.Fatalf("Refresh calls before release = %d, want 1", got)
+	}
+	close(release)
+
+	for index := 0; index < 2; index++ {
+		if errRefresh := <-errs; errRefresh != nil {
+			t.Fatalf("refresh %d error = %v", index+1, errRefresh)
+		}
+		refreshed := <-results
+		if got := authAccessToken(refreshed); got != "fresh-access-token" {
+			t.Fatalf("refresh %d access token = %q, want refreshed token", index+1, got)
+		}
+	}
+	if got := executor.RefreshCalls(); got != 1 {
