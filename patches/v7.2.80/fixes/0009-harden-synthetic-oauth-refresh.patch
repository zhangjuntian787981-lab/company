+package auth
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+type oauthSafetyTokenStorage struct {
+	payload  []byte
+	writeErr error
+	metadata map[string]any
+}
+
+func (s *oauthSafetyTokenStorage) SetMetadata(metadata map[string]any) {
+	s.metadata = metadata
+}
+
+func (s *oauthSafetyTokenStorage) SaveTokenToFile(path string) error {
+	if errWrite := os.WriteFile(path, s.payload, 0o666); errWrite != nil {
+		return errWrite
+	}
+	return s.writeErr
+}
+
+func TestFileTokenStoreOAuthRotationIsAtomicAndPrivate(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "codex.json")
+	if errWrite := os.WriteFile(path, []byte(`{"access_token":"old"}`), 0o644); errWrite != nil {
+		t.Fatalf("seed token file: %v", errWrite)
+	}
+
+	store := NewFileTokenStore()
+	store.SetBaseDir(dir)
+	auth := &cliproxyauth.Auth{
+		ID:       "codex.json",
+		Provider: "codex",
+		FileName: "codex.json",
+		Storage: &oauthSafetyTokenStorage{
+			payload: []byte(`{"access_token":"new","refresh_token":"rotated"}`),
+		},
+		Metadata: map[string]any{"type": "codex"},
+	}
+
+	if _, errSave := store.Save(context.Background(), auth); errSave != nil {
+		t.Fatalf("Save() error = %v", errSave)
+	}
+	got, errRead := os.ReadFile(path)
+	if errRead != nil {
+		t.Fatalf("read token file: %v", errRead)
+	}
+	if string(got) != `{"access_token":"new","refresh_token":"rotated"}` {
+		t.Fatalf("token file was not replaced with the complete payload")
+	}
+	info, errStat := os.Stat(path)
+	if errStat != nil {
+		t.Fatalf("stat token file: %v", errStat)
+	}
+	if gotMode := info.Mode().Perm(); gotMode != 0o600 {
+		t.Fatalf("token file mode = %04o, want 0600", gotMode)
+	}
+	assertNoOAuthSafetyTempFiles(t, dir)
+}
+
+func TestFileTokenStoreOAuthRotationFailureKeepsPreviousFile(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "codex.json")
+	previous := []byte(`{"access_token":"still-valid"}`)
+	if errWrite := os.WriteFile(path, previous, 0o600); errWrite != nil {
+		t.Fatalf("seed token file: %v", errWrite)
+	}
+
+	store := NewFileTokenStore()
+	store.SetBaseDir(dir)
+	auth := &cliproxyauth.Auth{
+		ID:       "codex.json",
+		Provider: "codex",
+		FileName: "codex.json",
+		Storage: &oauthSafetyTokenStorage{
+			payload:  []byte(`{"access_token":"partial"`),
+			writeErr: errors.New("synthetic interrupted rotation"),
+		},
+		Metadata: map[string]any{"type": "codex"},
+	}
+
+	if _, errSave := store.Save(context.Background(), auth); errSave == nil {
+		t.Fatal("Save() error = nil, want interrupted rotation error")
+	}
+	got, errRead := os.ReadFile(path)
+	if errRead != nil {
+		t.Fatalf("read previous token file: %v", errRead)
+	}
+	if string(got) != string(previous) {
+		t.Fatal("failed rotation changed the previous token file")
+	}
+	assertNoOAuthSafetyTempFiles(t, dir)
+}
+
+func assertNoOAuthSafetyTempFiles(t *testing.T, dir string) {
+	t.Helper()
+	matches, errGlob := filepath.Glob(filepath.Join(dir, ".auth-*.tmp"))
+	if errGlob != nil {
+		t.Fatalf("glob temporary auth files: %v", errGlob)
+	}
+	if len(matches) != 0 {
+		t.Fatalf("temporary auth files remain after save: %d", len(matches))
+	}
+}
