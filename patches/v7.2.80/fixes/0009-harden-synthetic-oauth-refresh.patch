+func parseCodexRetryAfter(resp *http.Response) time.Duration {
+	if resp == nil {
+		return codexRefreshMinBackoff
+	}
+	if raw := strings.TrimSpace(resp.Header.Get("Retry-After")); raw != "" {
+		if seconds, errParse := time.ParseDuration(raw + "s"); errParse == nil {
+			return clampCodexRefreshBackoff(seconds)
+		}
+		if when, errParse := http.ParseTime(raw); errParse == nil {
+			return clampCodexRefreshBackoff(time.Until(when))
+		}
+	}
+	if raw := strings.TrimSpace(resp.Header.Get("Retry-After-Ms")); raw != "" {
+		if milliseconds, errParse := time.ParseDuration(raw + "ms"); errParse == nil {
+			return clampCodexRefreshBackoff(milliseconds)
+		}
+	}
+	return codexRefreshMinBackoff
+}
+
+func clampCodexRefreshBackoff(value time.Duration) time.Duration {
+	if value < codexRefreshMinBackoff {
+		return codexRefreshMinBackoff
+	}
+	if value > codexRefreshMaxBackoff {
+		return codexRefreshMaxBackoff
+	}
+	return value
