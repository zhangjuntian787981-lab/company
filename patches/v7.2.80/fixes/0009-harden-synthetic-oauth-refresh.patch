+func replaceFileAtomically(path string, write func(string) error) error {
+	dir := filepath.Dir(path)
+	temp, errCreate := os.CreateTemp(dir, ".auth-*.tmp")
+	if errCreate != nil {
+		return fmt.Errorf("auth filestore: create temp file failed: %w", errCreate)
+	}
+	tempPath := temp.Name()
+	defer func() {
+		_ = os.Remove(tempPath)
+	}()
+	if errClose := temp.Close(); errClose != nil {
+		return fmt.Errorf("auth filestore: close temp file failed: %w", errClose)
+	}
+	if errMode := os.Chmod(tempPath, 0o600); errMode != nil {
+		return fmt.Errorf("auth filestore: secure temp file failed: %w", errMode)
+	}
+	if errWrite := write(tempPath); errWrite != nil {
+		return fmt.Errorf("auth filestore: write temp file failed: %w", errWrite)
+	}
+	if errMode := os.Chmod(tempPath, 0o600); errMode != nil {
+		return fmt.Errorf("auth filestore: secure token file failed: %w", errMode)
+	}
+	syncFile, errOpen := os.Open(tempPath)
+	if errOpen != nil {
+		return fmt.Errorf("auth filestore: open temp file failed: %w", errOpen)
+	}
+	if errSync := syncFile.Sync(); errSync != nil {
+		_ = syncFile.Close()
+		return fmt.Errorf("auth filestore: sync temp file failed: %w", errSync)
+	}
+	if errClose := syncFile.Close(); errClose != nil {
+		return fmt.Errorf("auth filestore: close synced temp file failed: %w", errClose)
+	}
+	if errRename := os.Rename(tempPath, path); errRename != nil {
+		return fmt.Errorf("auth filestore: replace token file failed: %w", errRename)
+	}
+	return nil
+}
