+func claudeRequestPolicyForRoute(rawJSON []byte) (*claudeRequestPolicy, error) {
+	model := strings.TrimSpace(gjson.GetBytes(rawJSON, "model").String())
+	baseModel := model
+	if suffix := strings.LastIndex(baseModel, "("); suffix > 0 && strings.HasSuffix(baseModel, ")") {
+		baseModel = strings.TrimSpace(baseModel[:suffix])
+	}
+	providers := registry.GetGlobalRegistry().GetModelProviders(baseModel)
+	if len(providers) == 0 {
+		return preflightClaudeRequest(rawJSON)
+	}
+	for _, provider := range providers {
+		if !strings.EqualFold(strings.TrimSpace(provider), "codex") {
+			return &claudeRequestPolicy{rawJSON: rawJSON}, nil
+		}
+	}
+	return preflightClaudeRequest(rawJSON)
+}
