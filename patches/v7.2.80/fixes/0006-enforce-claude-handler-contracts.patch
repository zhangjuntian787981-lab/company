+func claudeCatalogModels(models []map[string]any) []map[string]any {
+	filtered := make([]map[string]any, 0, len(models))
+	for _, model := range models {
+		id, ok := model["id"].(string)
+		id = strings.TrimSpace(id)
+		lowerID := strings.ToLower(id)
+		if !ok || !strings.HasPrefix(lowerID, "claude-") || strings.HasPrefix(lowerID, "claude-fable-5-dd-") {
+			continue
+		}
+		copyModel := make(map[string]any, len(model))
+		for key, value := range model {
+			copyModel[key] = value
+		}
+		copyModel["id"] = id
+		filtered = append(filtered, copyModel)
+	}
+	return filtered
+}
