+	body := fmt.Sprintf(`{"model":"test","max_tokens":64,"messages":[{"role":"user","content":[{"type":"document","source":{"type":"base64","media_type":"application/pdf","data":%q}}]}]}`, tooLarge)
+	if _, err := preflightClaudeRequest([]byte(body)); err == nil || !strings.Contains(err.Error(), "per-document size limit") {
