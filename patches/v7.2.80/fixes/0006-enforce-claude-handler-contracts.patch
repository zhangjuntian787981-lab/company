+		{name: "file URL", source: `{"type":"url","media_type":"application/pdf","url":"file:///tmp/private.pdf"}`, path: ".source.url"},
+		{name: "unknown MIME", source: `{"type":"base64","media_type":"application/octet-stream","data":"cGRm"}`, path: ".source.media_type"},
+		{name: "unknown source field", source: `{"type":"base64","media_type":"application/pdf","data":"cGRm","file_id":"secret"}`, path: ".source.file_id"},
+	}
+	for _, tt := range tests {
