+func TestPreflightClaudeRequestValidatesDocuments(t *testing.T) {
+	validData := base64.StdEncoding.EncodeToString([]byte("pdf"))
+	valid := fmt.Sprintf(`{
+		"model":"test","max_tokens":64,
+		"messages":[{"role":"user","content":[
+			{"type":"document","source":{"type":"base64","media_type":"application/pdf","data":%q}},
+			{"type":"document","source":{"type":"url","url":"https://example.test/file.txt?private=value"}}
+		]}]
+	}`, validData)
+	if _, err := preflightClaudeRequest([]byte(valid)); err != nil {
+		t.Fatalf("valid documents rejected: %v", err)
+	}
+
+	tests := []struct {
+		name   string
+		source string
+		path   string
+	}{
