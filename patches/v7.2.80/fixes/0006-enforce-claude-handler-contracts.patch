+			_, err := preflightClaudeRequest([]byte(body))
+			if err == nil || !strings.Contains(err.Error(), tt.path) {
+				t.Fatalf("error = %v, want path %s", err, tt.path)
+			}
+			if strings.Contains(fmt.Sprint(err), "private=value") {
