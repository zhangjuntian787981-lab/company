+func TestPreflightClaudeRequestValidatesMaxTokens(t *testing.T) {
+	for _, value := range []string{`0`, `-1`, `1.5`, `"64"`, `null`} {
+		t.Run(value, func(t *testing.T) {
+			_, err := preflightClaudeRequest([]byte(fmt.Sprintf(`{"model":"test","max_tokens":%s,"messages":[]}`, value)))
+			if err == nil || !strings.Contains(err.Error(), "$.max_tokens") {
+				t.Fatalf("error = %v, want max_tokens policy error", err)
+			}
+		})
+	}
+	policy, err := preflightClaudeRequest([]byte(`{"model":"test","max_tokens":64,"messages":[]}`))
+	if err != nil {
+		t.Fatalf("valid max_tokens rejected: %v", err)
+	}
+	if policy.constraints.maxTokens != 64 {
+		t.Fatalf("maxTokens = %d, want 64", policy.constraints.maxTokens)
+	}
+}
+
+func TestPreflightClaudeRequestTakesStopSequences(t *testing.T) {
+	policy, err := preflightClaudeRequest([]byte(`{
+		"model":"test",
+		"max_tokens":64,
+		"stop_sequences":["END","DONE"],
+		"messages":[{"role":"user","content":"hello"}]
+	}`))
+	if err != nil {
+		t.Fatalf("preflight: %v", err)
+	}
+	if got := strings.Join(policy.constraints.stopSequences, ","); got != "END,DONE" {
+		t.Fatalf("stop sequences = %q", got)
+	}
+	if gjson.GetBytes(policy.rawJSON, "stop_sequences").Exists() {
+		t.Fatalf("locally enforced stop_sequences reached upstream body: %s", policy.rawJSON)
+	}
+}
+
+func TestPreflightClaudeRequestRejectsDeferLoadingTrue(t *testing.T) {
+	_, err := preflightClaudeRequest([]byte(`{
+		"model":"test",
+		"max_tokens":64,
+		"tools":[{"name":"lookup","input_schema":{"type":"object"},"defer_loading":true}],
+		"messages":[]
+	}`))
+	if err == nil || !strings.Contains(err.Error(), "$.tools[0].defer_loading") {
