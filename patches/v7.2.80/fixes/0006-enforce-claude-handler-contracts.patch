+func TestClaudeCatalogModelsPublishesOnlyExplicitClaudeIDs(t *testing.T) {
+	input := []map[string]any{
+		{"id": "claude-opus-4-8", "display_name": "Opus"},
+		{"id": "claude-fable-5-dd-los-6.5-tpg", "display_name": "Legacy encoded"},
+		{"id": "gpt-5.6-sol", "display_name": "GPT"},
+		{"id": "compat-text", "display_name": "Fixture"},
+	}
+	models := claudeCatalogModels(input)
+	if len(models) != 1 || models[0]["id"] != "claude-opus-4-8" {
+		t.Fatalf("Claude catalog = %v, want only explicit Claude alias", models)
+	}
+	if input[2]["id"] != "gpt-5.6-sol" {
+		t.Fatalf("catalog filtering mutated registry input: %v", input)
+	}
+}
