+func TestClaudeRequestPolicyIsCodexRouteScoped(t *testing.T) {
+	registryRef := registry.GetGlobalRegistry()
+	tests := []struct {
+		name       string
+		provider   string
+		model      string
+		wantReject bool
+	}{
+		{name: "Codex alias enforces policy", provider: "codex", model: "claude-policy-codex-test", wantReject: true},
+		{name: "native Claude preserves fields", provider: "claude", model: "claude-policy-native-test", wantReject: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			clientID := tt.model + "-client"
+			registryRef.RegisterClient(clientID, tt.provider, []*registry.ModelInfo{{ID: tt.model}})
+			t.Cleanup(func() { registryRef.UnregisterClient(clientID) })
+			body := []byte(`{"model":"` + tt.model + `","max_tokens":64,"tools":[{"name":"lookup","defer_loading":true,"input_schema":{"type":"object"}}],"messages":[]}`)
+			policy, err := claudeRequestPolicyForRoute(body)
+			if tt.wantReject {
+				if err == nil {
+					t.Fatal("Codex route accepted unsupported defer_loading=true")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("native Claude policy: %v", err)
+			}
+			if policy.codexRoute || !bytes.Equal(policy.rawJSON, body) {
+				t.Fatalf("native Claude request was changed: codex=%v body=%s", policy.codexRoute, policy.rawJSON)
+			}
+		})
+	}
+}
