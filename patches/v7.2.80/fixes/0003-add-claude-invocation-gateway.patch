+func TestParseTargetRequiresNonProductionLoopback(t *testing.T) {
+	for _, raw := range []string{
+		"https://127.0.0.1:9000",
+		"http://example.com:9000",
+		"http://127.0.0.1:8317",
+		"http://127.0.0.1",
+	} {
+		if _, err := ParseTarget(raw); err == nil {
+			t.Fatalf("ParseTarget(%q) succeeded, want rejection", raw)
+		}
+	}
+	if _, err := ParseTarget("http://127.0.0.1:9000"); err != nil {
+		t.Fatalf("valid loopback target rejected: %v", err)
+	}
+}
+
+func newTestGateway(t *testing.T, targetURL string) *Gateway {
+	t.Helper()
+	target, err := ParseTarget(targetURL)
+	if err != nil {
+		t.Fatalf("ParseTarget: %v", err)
+	}
+	gateway, err := New(Config{
+		Target:         target,
+		ConnectTimeout: 2 * time.Second,
+	})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	return gateway
+}
+
+func postTestRequest(t *testing.T, baseURL string, body []byte) (int, []byte) {
+	t.Helper()
+	return postTestRequestWithHeaders(t, baseURL, body, nil)
+}
+
+func postTestRequestWithHeaders(t *testing.T, baseURL string, body []byte, headers map[string]string) (int, []byte) {
+	t.Helper()
+	request, err := http.NewRequest(http.MethodPost, baseURL+"/v1/messages", bytes.NewReader(body))
+	if err != nil {
+		t.Fatalf("NewRequest: %v", err)
+	}
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("Authorization", "Bearer synthetic-test-key")
+	for name, value := range headers {
+		request.Header.Set(name, value)
+	}
+	response, err := http.DefaultClient.Do(request)
+	if err != nil {
+		t.Fatalf("Do: %v", err)
+	}
+	defer response.Body.Close()
+	responseBody, err := io.ReadAll(response.Body)
+	if err != nil {
+		t.Fatalf("ReadAll: %v", err)
+	}
+	return response.StatusCode, responseBody
+}
