+func TestGatewaySetsOnlyConnectionTimeout(t *testing.T) {
+	target := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+	defer target.Close()
+
+	gateway := newTestGateway(t, target.URL)
+	if gateway.client.Timeout != 0 {
+		t.Fatalf("client timeout = %v, want no whole-request timeout", gateway.client.Timeout)
+	}
+	transport, ok := gateway.client.Transport.(*http.Transport)
+	if !ok {
+		t.Fatalf("transport type = %T, want *http.Transport", gateway.client.Transport)
+	}
+	if transport.ResponseHeaderTimeout != 0 {
+		t.Fatalf("response header timeout = %v, want none after connection", transport.ResponseHeaderTimeout)
+	}
+}
