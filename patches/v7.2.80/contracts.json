{
  "schema_version": 1,
  "classification_definitions": {
    "SUPPORTED": "Preserved without a semantic downgrade.",
    "TRANSLATED": "Mapped to a different protocol field or terminal semantic.",
    "DROPPED_WITH_WARNING": "Omitted with an observable warning.",
    "DROPPED_SILENTLY": "Omitted or weakened without an observable warning.",
    "REJECTED": "Rejected as an error or unsafe to claim as compatible."
  },
  "contracts": [
    {
      "id": "tool-argument-delta-call-id-isolation",
      "feature": "Two interleaved tool argument delta streams remain isolated by call ID.",
      "classification": "SUPPORTED",
      "observed": "The repair keeps function-call state isolated by call_id, item_id, and output_index, then emits complete tool blocks sequentially in stable order; ambiguous unkeyed deltas fail closed.",
      "evidence": [
        {
          "origin": "SUPPLEMENTAL_PATCH",
          "package": "github.com/router-for-me/CLIProxyAPI/v7/internal/translator/codex/claude",
          "test": "TestCompatInterleavedToolArgumentDeltasAreIsolatedByCallID"
        },
        {
          "origin": "REPAIR_PATCH",
          "package": "github.com/router-for-me/CLIProxyAPI/v7/internal/translator/codex/claude",
          "test": "TestConvertCodexResponseToClaude_StreamInterleavedNamedFunctionCallsStayIsolated"
        }
      ]
    },
    {
      "id": "claude-request-attempt-budget",
      "feature": "One Claude inbound request cannot replay generation across credentials, models, or configured retries unless a successful OAuth refresh authorizes one replay.",
      "classification": "SUPPORTED",
      "observed": "The request-scoped budget preserves the original provider error after one generation attempt, while allowing exactly one successful 401 refresh replay.",
      "evidence": [
        {
          "origin": "REPAIR_PATCH",
          "package": "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth",
          "test": "TestManagerRequestBudgetStopsCrossCredentialAttempts"
