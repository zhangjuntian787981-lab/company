        {
          "origin": "REPAIR_PATCH",
          "package": "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth",
          "test": "TestManagerRequestBudgetAllowsOneSuccessfulUnauthorizedRefreshReplay"
        },
        {
          "origin": "REPAIR_PATCH",
          "package": "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth",
          "test": "TestRequestBudgetRefreshAttemptLimit"
        }
      ]
    },
